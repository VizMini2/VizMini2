<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vizmini2</name>
  <version>1.1.0</version>
  <description>VizMini2 for the desktop: 3D view, topics, teleop, parameters, lifecycle and more for ROS 2, the same app as on Android. Start it with `ros2 run vizmini2 vizmini2`.</description>
  <maintainer email="jc.manzanares.serrano@gmail.com">Juan Carlos Manzanares Serrano</maintainer>
  <author email="jc.manzanares.serrano@gmail.com">Juan Carlos Manzanares Serrano</author>
  <license>GPL-3.0-only</license>
  <url type="website">https://vizmini2.github.io/</url>
  <url type="repository">https://github.com/VizMini2/VizMini2</url>
  <url type="bugtracker">https://github.com/VizMini2/VizMini2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Gradle descarga sus dependencias y su JDK (ver CMakeLists.txt); el programa lleva su propio Java dentro. -->
  <build_depend>curl</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
