# RViz 2 configuration for tools/navmap_demo.py (works in RViz with navmap_rviz_plugin, and in VizMini2:
# ./gradlew :desktopApp:run --args="--import tools/navmap_demo.rviz").
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: navmap_rviz_plugin/NavMapDisplay
      Draw Links: true
      Enabled: true
      Layer: cost
      Name: NavMap
      Topic:
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /navmap
      Update Layer Topic:
        Value: /navmap_layers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 19
      Focal Point:
        X: 9
        Y: 4
        Z: 1
      Name: Current View
      Pitch: 0.75
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.7
    Saved: ~
