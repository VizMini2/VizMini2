<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset><unit name="centimeter" meter="0.01"/><up_axis>Y_UP</up_axis></asset>
  <library_effects>
    <effect id="red-fx"><profile_COMMON><technique sid="t"><phong><diffuse><color>1 0 0 1</color></diffuse></phong></technique></profile_COMMON></effect>
    <effect id="green-fx"><profile_COMMON><technique sid="t"><lambert><diffuse><color>0 1 0 1</color></diffuse></lambert></technique></profile_COMMON></effect>
  </library_effects>
  <library_materials>
    <material id="red"><instance_effect url="#red-fx"/></material>
    <material id="green"><instance_effect url="#green-fx"/></material>
  </library_materials>
  <library_geometries>
    <geometry id="mast">
      <mesh>
        <source id="mast-pos">
          <!-- Mástil: caja de 4x40x4 cm (Y arriba en Collada) -->
          <float_array id="mast-pos-array" count="24">-2 0 -2  2 0 -2  2 0 2  -2 0 2  -2 40 -2  2 40 -2  2 40 2  -2 40 2</float_array>
          <technique_common><accessor source="#mast-pos-array" count="8" stride="3"/></technique_common>
        </source>
        <vertices id="mast-vtx"><input semantic="POSITION" source="#mast-pos"/></vertices>
        <polylist material="RED" count="6">
          <input semantic="VERTEX" source="#mast-vtx" offset="0"/>
          <vcount>4 4 4 4 4 4</vcount>
          <p>0 1 2 3  4 7 6 5  0 4 5 1  1 5 6 2  2 6 7 3  3 7 4 0</p>
        </polylist>
      </mesh>
    </geometry>
    <geometry id="tip">
      <mesh>
        <source id="tip-pos">
          <float_array id="tip-pos-array" count="12">-5 0 -5  5 0 -5  0 0 5  0 10 0</float_array>
          <technique_common><accessor source="#tip-pos-array" count="4" stride="3"/></technique_common>
        </source>
        <vertices id="tip-vtx"><input semantic="POSITION" source="#tip-pos"/></vertices>
        <triangles material="GREEN" count="4">
          <input semantic="VERTEX" source="#tip-vtx" offset="0"/>
          <p>0 1 3  1 2 3  2 0 3  0 2 1</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene">
      <node id="mast-node">
        <instance_geometry url="#mast"><bind_material><technique_common><instance_material symbol="RED" target="#red"/></technique_common></bind_material></instance_geometry>
        <node id="tip-node">
          <translate>0 40 0</translate>
          <instance_geometry url="#tip"><bind_material><technique_common><instance_material symbol="GREEN" target="#green"/></technique_common></bind_material></instance_geometry>
        </node>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
