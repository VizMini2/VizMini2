# Configuración estilo Nav2 (escrita a mano para las pruebas del importador)
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 2
      Class: rviz_default_plugins/Grid
      Color: 100; 100; 100
      Enabled: true
      Line Style:
        Line Width: 0.05
        Value: Billboards
      Name: Grid
      Offset:
        X: 0
        Y: 0
        Z: 0.1
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: false
          Class: rviz_default_plugins/LaserScan
          Color: 255; 0; 0
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Max Intensity: 100
          Min Intensity: 0
          Name: LaserScan
          Size (m): 0.08
          Style: Spheres
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /scan
          Value: true
        - Class: rviz_default_plugins/Image
          Enabled: true
          Name: Cámara
          Topic:
            Value: /camera/image_raw
          Value: true
      Enabled: false
      Name: Sensores
    - Alpha: 1
      Class: rviz_default_plugins/Path
      Color: 0; 0; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: "Plan global"
      Pose Style: Arrows
      Topic:
        Value: /plan
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 50
      Name: Odometry
      Shape:
        Alpha: 1
        Color: 255; 25; 0
        Value: Axes
        Axes Length: 0.5
      Topic: /odom
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: false
      Min Value: -1
      Max Value: 2
      Enabled: true
      Name: Nube
      Topic:
        Value: /points
      Value: true
  Enabled: true
  Global Options:
    Background Color: 10; 20; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose_custom
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /my_goal
  Value: true
  Views:
    Current:
      Angle: 0.5
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 50
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 1.5
      Y: -2
    Saved: ~
Window Geometry:
  Height: 1016
  Width: 1848
