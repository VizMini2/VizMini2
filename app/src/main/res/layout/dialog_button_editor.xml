<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/btnLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/buttons_editor_label_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="40" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/btnKindGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/kindPublish"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="@string/buttons_kind_publish" />

            <Button
                android:id="@+id/kindService"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="@string/buttons_kind_service" />

            <Button
                android:id="@+id/kindAction"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="@string/buttons_kind_action" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <AutoCompleteTextView
                android:id="@+id/btnTarget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:completionThreshold="1"
                android:hint="@string/buttons_editor_topic_hint"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textUri" />

            <!-- Pick from what is on the network (topics, services or actions with their type) -->
            <Button
                android:id="@+id/btnBrowse"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buttons_editor_browse" />
        </LinearLayout>

        <Button
            android:id="@+id/btnType"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="@string/buttons_editor_choose_type" />

        <TextView
            android:id="@+id/btnError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnFieldsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/buttons_editor_fields"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <FrameLayout
            android:id="@+id/btnForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/buttons_editor_options"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout
            android:id="@+id/publishOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/btnQosGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/qosReliable"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="2dp"
                    android:text="@string/buttons_editor_reliable"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/qosBestEffort"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="2dp"
                    android:text="@string/buttons_editor_best_effort"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/qosLatched"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="2dp"
                    android:text="@string/buttons_editor_transient_local"
                    android:textSize="12sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/buttons_editor_repeat" />

                <EditText
                    android:id="@+id/btnRepeatHz"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:text="0" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/btnStopOnRelease"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/buttons_editor_stop_on_release" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timeoutOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTimeoutLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/buttons_editor_response_timeout" />

            <EditText
                android:id="@+id/btnTimeout"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:text="5" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/buttons_editor_confirm" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/buttons_editor_color" />

        <LinearLayout
            android:id="@+id/btnColors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:paddingVertical="6dp" />
    </LinearLayout>
</ScrollView>
