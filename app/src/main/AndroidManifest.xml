<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- zenoh-kotlin-android declares minSdk 30, but its native part supports 21 and up (see build.gradle.kts). -->
    <uses-sdk tools:overrideLibrary="io.zenoh" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Optional service to keep the ROS 2 connection in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Screen recording (the record button): MediaProjection in a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".VizMiniApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VizMini2"
        android:usesCleartextTraffic="true">
        <!-- Stores the language chosen in the app on Android < 13 (AppCompat). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <!-- No sign-in screen: the app opens directly on Home. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".params.NodeInspectorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".graph.GraphActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".explore.TopicActivity"
            android:exported="false" />

        <activity
            android:name=".explore.ServiceActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".explore.ActionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".tabs.AddTabActivity"
            android:exported="false" />

        <activity
            android:name=".tabs.AddTabDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".home.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.VizMini2.Auth" />

        <activity
            android:name=".PrivacyActivity"
            android:exported="false" />

        <activity
            android:name=".home.ChangelogActivity"
            android:exported="false"
            android:label="Changelog" />

        <!-- Sharing recorded bags -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".ros.RosForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <service
            android:name=".record.ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- ML Kit's QR scanner: an invisible activity that ML Kit locks to portrait. Android 16 ignores that on
             tablets and foldables and Google Play asks for it not to be there. -->
        <activity
            android:name="com.google.mlkit.vision.codescanner.internal.GmsBarcodeScanningDelegateActivity"
            android:screenOrientation="unspecified"
            tools:replace="android:screenOrientation" />
    </application>

</manifest>